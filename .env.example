# Application Settings
APP_NAME="Jev Proxy"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
PRODUCTION=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# TypeSafe Jev Upstream
# The key normally arrives per request as the bearer token (MinusPod's provider
# api_key). Set it here only as a fallback for direct callers; leave blank otherwise.
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_CACHE_PATH=./jev_cache.json
JEV_CACHE_MAX_ENTRIES=10000
JEV_TIMEOUT_SECONDS=60
JEV_MAX_RETRIES=2
JEV_RETRY_AFTER_MAX_SECONDS=5
# This must stay below nginx's 90 second proxy timeout.
JEV_REQUEST_DEADLINE_SECONDS=75

# The caller's Authorization bearer token is the normal TypeSafe credential.
# Set this to true only for an internal deployment that intentionally permits
# the configured TYPESAFE_API_KEY fallback without a caller bearer token.
JEV_ALLOW_UNAUTHENTICATED_FALLBACK=false
JEV_MAX_CONCURRENT_REQUESTS=4
JEV_MAX_SEGMENTS=300
JEV_MAX_TRANSCRIPT_CHARS=200000

# Sponsor naming via MinusPod's API. The proxy logs in with MINUSPOD_PASSWORD
# (MinusPod's login password, not the TypeSafe key) for a session cookie, then
# reads GET /api/v1/sponsors. Leave MINUSPOD_BASE_URL blank to fall back to the
# built-in gazetteer.
MINUSPOD_BASE_URL=
MINUSPOD_PASSWORD=
SPONSOR_CACHE_TTL_SECONDS=3600
MINUSPOD_SESSION_TTL_SECONDS=1800
# Per-worker cooldown. Account for worker and replica counts against MinusPod's
# login limits; the Docker default of 2 workers uses 900 seconds.
SPONSOR_FAILURE_COOLDOWN_SECONDS=900

# Docker Compose publishes to loopback by default. Set to 0.0.0.0 only when
# intentional LAN or reverse-proxy exposure is protected separately.
JEVPROXY_BIND_ADDRESS=127.0.0.1

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
