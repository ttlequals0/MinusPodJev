# Application Settings
APP_NAME="Jev Proxy"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
PRODUCTION=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# TypeSafe Jev Upstream
# The key normally arrives per request as the bearer token (MinusPod's provider
# api_key). Set it here only as a fallback for direct callers; leave blank otherwise.
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_CACHE_PATH=./jev_cache.json
JEV_TIMEOUT_SECONDS=60

# Sponsor lookup via MinusPod's own API (to name sponsors on detected ads).
# MINUSPOD_API_TOKEN is MinusPod's API key, not the TypeSafe key. Leave the URL
# blank to fall back to the built-in gazetteer.
MINUSPOD_SPONSORS_URL=
MINUSPOD_API_TOKEN=
SPONSOR_CACHE_TTL_SECONDS=3600

# Database Configuration
# Options: sqlite or postgresql
DATABASE_TYPE=sqlite

# SQLite settings (if DATABASE_TYPE=sqlite)
SQLITE_DATABASE_PATH=./webapp.db

# Security
# Generate a secure key for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
